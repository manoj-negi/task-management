package routes

import (
	"database/sql"
	"net/http"

	"office-task-manager/backend/internal/auth"
	"office-task-manager/backend/internal/handlers"
)

func New(db *sql.DB) http.Handler {
	mux := http.NewServeMux()

	mux.HandleFunc("/api/health", handlers.Health(db))

	authHandler := handlers.AuthHandler{DB: db}
	mux.HandleFunc("/api/auth/login", authHandler.Login)

	mux.Handle(
		"/api/auth/me",
		auth.RequireAuth(http.HandlerFunc(authHandler.Me)),
	)
	mux.Handle(
		"/api/dashboard",
		auth.RequireAuth(http.HandlerFunc(handlers.Dashboard(db))),
	)
	mux.Handle("/api/tasks", auth.RequireAuth(http.HandlerFunc(handlers.CreateTask(db))))
	mux.Handle("/api/assignable-users", auth.RequireAuth(http.HandlerFunc(handlers.AssignableUsers(db))))

	mux.Handle("/api/tasks/", auth.RequireAuth(http.HandlerFunc(handlers.TaskAction(db))))

	return corsMiddleware(mux)
}

func corsMiddleware(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		origin := r.Header.Get("Origin")

		if origin == "http://localhost:5173" ||
			origin == "http://127.0.0.1:5173" {
			w.Header().Set("Access-Control-Allow-Origin", origin)
			w.Header().Set("Vary", "Origin")
			w.Header().Set("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
			w.Header().Set("Access-Control-Allow-Headers", "Content-Type, Authorization")
		}

		if r.Method == http.MethodOptions {
			if origin != "http://localhost:5173" &&
				origin != "http://127.0.0.1:5173" {
				http.Error(w, "Origin not allowed", http.StatusForbidden)
				return
			}

			w.WriteHeader(http.StatusNoContent)
			return
		}

		next.ServeHTTP(w, r)
	})
}
